# Public site URL used for canonical links, the sitemap, and Open Graph.
# Example: https://www.ascentdesignstudios.com
NEXT_PUBLIC_SITE_URL=

# Verified studio contact details. Leave a value blank to hide that field.
NEXT_PUBLIC_STUDIO_EMAIL=
NEXT_PUBLIC_STUDIO_PHONE=
NEXT_PUBLIC_STUDIO_WHATSAPP=
NEXT_PUBLIC_STUDIO_LOCATION=
NEXT_PUBLIC_STUDIO_HOURS=By appointment

# Full profile URLs, including https://. Leave blank to hide a network.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# Inquiry delivery. All three are required before the contact form can send mail.
# RESEND_FROM_EMAIL must be a sender address verified with Resend.
# Until these are set, the form explains that the message was not sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
STUDIO_INQUIRY_EMAIL=
